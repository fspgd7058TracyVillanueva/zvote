# FHEVote Environment Variables

# Network Configuration
SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Private Key for Deployment
PRIVATE_KEY=your_private_key_here

# Contract Addresses (will be filled after deployment)
VITE_CONTRACT_ADDRESS=
VITE_FHE_ORACLE_ADDRESS=

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api

# Backend Configuration
PORT=3001

# Note: This project uses MetaMask wallet connection, no third-party authentication services needed.
# No database is used - all data is stored on the blockchain.
